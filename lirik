def get_player_info():
    try:
        meta = subprocess.check_output(["playerctl", "metadata", "--format", "{{artist}}\t{{title}}"], stderr=subprocess.DEVNULL)
        if not meta: return None, None, 0, "Stopped"
        parts = meta.decode("utf-8").strip().split('\t', 1)
        if len(parts) != 2: return None, None, 0, "Stopped"
        artist, title = parts
        
        pos = subprocess.check_output(["playerctl", "position"], stderr=subprocess.DEVNULL)
        position = float(pos.decode("utf-8").strip())
        
        status = subprocess.check_output(["playerctl", "status"], stderr=subprocess.DEVNULL).decode("utf-8").strip()
        
        return artist, title, position, status
    except Exception:
        return None, None, 0, "Stopped"

def fetch_lyrics(artist, title):
    safe_name = f"{artist} - {title}".replace("/", "_")
    cache_file = os.path.join(CACHE_DIR, f"{safe_name}.json")
    if os.path.exists(cache_file):
        try:
            with open(cache_file, "r") as f:
                return json.load(f)
        except:
            pass
            
    # Try exact match first
    query = urllib.parse.urlencode({"artist_name": artist, "track_name": title})
    url = f"https://lrclib.net/api/get?{query}"
    
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'Lirik-CLI-Ricer/1.0'})
        with urllib.request.urlopen(req, timeout=15) as response:
            data = json.loads(response.read().decode())
            if "syncedLyrics" in data and data["syncedLyrics"]:
                with open(cache_file, "w") as f:
                    json.dump(data["syncedLyrics"], f)
                return data["syncedLyrics"]
    except Exception:
        pass
        
    # Fallback to search
    query_search = urllib.parse.urlencode({"q": f"{artist} {title}"})
    url_search = f"https://lrclib.net/api/search?{query_search}"
    try:
        req = urllib.request.Request(url_search, headers={'User-Agent': 'Lirik-CLI-Ricer/1.0'})
        with urllib.request.urlopen(req, timeout=15) as response:
            data = json.loads(response.read().decode())
            if data and isinstance(data, list):
                for item in data:
                    if "syncedLyrics" in item and item["syncedLyrics"]:
                        with open(cache_file, "w") as f:
                            json.dump(item["syncedLyrics"], f)
                        return item["syncedLyrics"]
    except Exception:
        pass
    
    return None

def parse_lrc(lrc_text):
    lines = []
    for line in lrc_text.splitlines():
        if line.startswith("[") and "]" in line:
            time_str = line[1:line.find("]")]
            text = line[line.find("]")+1:].strip()
            try:
                if ":" in time_str:
                    m, s = time_str.split(":", 1)
                    time_sec = int(m) * 60 + float(s)
                    lines.append((time_sec, text))
            except ValueError:
                pass
    lines.sort()
    return lines

def get_pixel_text(text):
    text = text.upper()
    lines = ["", "", "", "", ""]
    for char in text:
        char_matrix = FONT.get(char, ["███","███","███","███","███"]) if char.isascii() else FONT.get('?', FONT[' '])
        for i in range(5):
            lines[i] += char_matrix[i] + " "
    return lines

def render(text, artist, title):
    cols, rows = shutil.get_terminal_size()
    # Move cursor to top-left and clear screen
    print("\033[H\033[2J", end="")
    
    header = f"{artist} - {title}"
    print("\033[38;5;245m" + header.center(cols) + "\033[0m")
    
    if not text.strip():
        return
        
    pixel_lines = get_pixel_text(text)
    max_len = len(pixel_lines[0])
    
    # Calculate vertical centering
    # Header is 1 line, pixel font is 5 lines
    pad_top = (rows - 6) // 2
    if pad_top > 0:
        print("\n" * pad_top, end="")
        
    if max_len < cols and max_len > 0:
        for line in pixel_lines:
            print("\033[1;36m" + line.center(cols) + "\033[0m")
    else:
        # If terminal is too small for pixel font, render normal big text
        print("\033[1;36m" + text.center(cols) + "\033[0m")

def main():
    print("\033[?25l", end="") # Hide cursor
    try:
        last_song = None
        lrc_data = []
        
        while True:
            artist, title, position, status = get_player_info()
            
            if not artist or status == "Stopped":
                cols, rows = shutil.get_terminal_size()
                print("\033[H\033[2J", end="")
                pad = (rows - 1) // 2
                print("\n" * pad, end="")
                print("Tidak ada lagu yang diputar di Spotify.".center(cols))
                time.sleep(2)
                continue
                
            current_song = f"{artist} - {title}"
            
            if current_song != last_song:
                last_song = current_song
                render("Mencari lirik...", artist, title)
                raw_lrc = fetch_lyrics(artist, title)
                if raw_lrc:
                    lrc_data = parse_lrc(raw_lrc)
                else:
                    lrc_data = []
                    
            if not lrc_data:
                render("[Lirik tidak ditemukan]", artist, title)
                time.sleep(2)
                continue
                
            current_line = ""
            for i, (t, txt) in enumerate(lrc_data):
                if position >= t:
                    current_line = txt
                else:
                    break
                    
            render(current_line, artist, title)
            time.sleep(0.1)
    except KeyboardInterrupt:
        pass
    finally:
        print("\033[?25h\033[H\033[2J", end="") # Show cursor and clear
        print("Selesai")

if __name__ == "__main__":
    main()
